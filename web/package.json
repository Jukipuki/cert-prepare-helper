{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run generate:questions",
    "dev": "next dev",
    "prebuild": "npm run generate:questions",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
